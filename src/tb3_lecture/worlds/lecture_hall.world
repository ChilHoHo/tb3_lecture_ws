<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="lecture_hall">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <model name="lecture_hall">
      <static>true</static>
      <include>
        <uri>model://lecture_hall</uri>
      </include>
    </model>

    <actor name="attendee_a">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>2.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint>
            <time>0.00</time>
            <pose>5.2 0.7 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>3.11</time>
            <pose>6.6 0.7 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>3.11</time>
            <pose>6.6 0.7 1.0 0 0 90</pose>
          </waypoint>
          <waypoint>
            <time>5.11</time>
            <pose>6.6 1.6 1.0 0 0 90</pose>
          </waypoint>
          <waypoint>
            <time>5.11</time>
            <pose>6.6 1.6 1.0 0 0 180</pose>
          </waypoint>
          <waypoint>
            <time>8.22</time>
            <pose>5.2 1.6 1.0 0 0 180</pose>
          </waypoint>
          <waypoint>
            <time>8.22</time>
            <pose>5.2 1.6 1.0 0 0 270</pose>
          </waypoint>
          <waypoint>
            <time>10.22</time>
            <pose>5.2 0.7 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>15.22</time>
            <pose>5.2 0.7 1.0 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="attendee_b">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>12.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint>
            <time>0.00</time>
            <pose>0.6 2.2 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>9.33</time>
            <pose>0.6 5.0 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>9.33</time>
            <pose>0.6 5.0 1.0 0 0 180</pose>
          </waypoint>
          <waypoint>
            <time>18.67</time>
            <pose>0.6 2.2 1.0 0 0 180</pose>
          </waypoint>
          <waypoint>
            <time>18.67</time>
            <pose>0.6 2.2 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>23.67</time>
            <pose>0.6 2.2 1.0 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

  </world>
</sdf>
